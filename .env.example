# ── textbee 設定 ──────────────────────────────────────────
# 從 https://app.textbee.dev/dashboard 取得
TEXTBEE_API_KEY=your_api_key_here

# Webhook 簽章驗證密鑰（在 dashboard 建立 Webhook 時會產生）
# 開發測試時可以不填，正式上線建議填入
TEXTBEE_WEBHOOK_SECRET=your_webhook_secret_here

# ── OpenAI 設定（選填）────────────────────────────────────
# 填入後啟用兩項功能：
#   1. 模糊語意解析：長輩可傳「護國神山今天怎樣」等自然語言
#   2. 「買哪隻安全」等開放性問題由 GPT 回答
# 不填則使用本地別名表（涵蓋常見股票暱稱）+ 固定回覆
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 資料庫 ────────────────────────────────────────────────
# 本機開發：使用 SQLite（預設）
DATABASE_URL=sqlite:///./stock_sms.db

# 正式部署（Render）：使用 PostgreSQL，貼上 Render 提供的 Internal Database URL
# 格式：postgresql://user:password@host/dbname
# DATABASE_URL=postgresql://stock_sms_user:xxxx@dpg-xxxx.oregon-postgres.render.com/stock_sms

# ── 應用程式設定 ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# Render 部署後的公開網址（用於 Keep-Alive，避免免費方案閒置睡著）
# 例：https://stock-sms-elder.onrender.com
APP_URL=
